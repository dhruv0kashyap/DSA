class Solution {
    static int countWays(String s) {
        
        return solve(s, 0, s.length() - 1, 1);
    
    }
    
    static int solve(String s, int i, int j, int isTrue){
        
        if(i > j)
        return 0;
        
        if(i == j){
            if(isTrue == 1){
                return s.charAt(i) == 'T' ? 1 : 0;
            }
            else{
                return s.charAt(i) == 'F' ? 1 : 0;
            }
        }
        
        long ans = 0;
        
        for(int k = i+1; k < j; k += 2){ // because 1st character is always an operand , 2nd character is an operator
            
            char c = s.charAt(k);
            
            int LT = solve(s, i, k-1, 1);
            int LF = solve(s, i, k-1, 0);
            int RT = solve(s, k+1, j, 1);
            int RF = solve(s, k+1, j, 0);
            
            if(c == '&'){
                
                if(isTrue == 1)
                    ans = ans + LT*RT;
                else{
                    ans = ans + LT*RF + LF*RT + LF*RF;
                }
                
            }
            
            else if(c == '|'){
                
                if(isTrue == 1)
                    ans = ans + LT*RF + LF*RT + LT*RT;
                else{
                    ans = ans + LF*RF;
                }
                
                
            }
            
            else if(c == '^'){

                if(isTrue == 1)
                    ans = ans + LT*RF + LF*RT;
                else{
                    ans = ans + LF*RF + LT*RT;
                }
                
            }
            
        }
        return (int)ans;
    }
}
