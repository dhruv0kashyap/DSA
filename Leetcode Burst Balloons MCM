class Solution {

    public int maxCoins(int[] nums) {

        int n = nums.length;

        int[] arr = new int[n+2];
        arr[0] = 1;
        arr[n+1] = 1;

        for(int a = 1; a < n+1; a++){
            arr[a] = nums[a - 1];
        }
        
        int[][] t = new int[n+2][n+2];
        
        for(int a = 0; a < n+2; a++){
            for(int b = 0; b < n+2; b++){
                t[a][b] = -1;
            }
        }

        return solve(arr, 1, n, t);       
    }

    public int solve(int[] arr, int i, int j, int[][] t){

        if(i > j){
            return 0;
        }

        if(t[i][j] != -1){
            return t[i][j];
        }
        
        int maxCost = Integer.MIN_VALUE;

        for(int k = i; k < j+1; k++){

            int tempAns = solve(arr, i, k-1, t) 
                          + solve(arr, k+1, j, t)
                          + arr[i-1] * arr[k] * arr[j+1];  
                          
            maxCost  = Math.max(maxCost, tempAns);                                    ;

        }

        return t[i][j] = maxCost;
    }
}
