class Solution {

    static int[][] t = new int[201][201];
    
    static int matrixMultiplication(int[] arr){
        int i = 1;
        int j = arr.length - 1;
        
        for(int a = 0; a < 201; a++){
            for(int b = 0; b < 201; b++){
                t[a][b] = -1;
            }
        }
        
        return Solve(arr, i, j);
        
    }
    
    static int Solve(int[] arr, int i, int j) {

               // Base Case: If there is only one matrix or no matrix left
               if (i >= j) {
                   return 0;
               }

               // If the subproblem is already solved, return the cached value
               if (t[i][j] != -1) {
                   return t[i][j];
               }

               int minCost = Integer.MAX_VALUE;

               // Place parenthesis at different positions between i and j
               for (int k = i; k < j; k++) {
                   // Cost of splitting at k + cost of multiplying the two resulting matrices
                   int tempAns = Solve(arr, i, k) 
                               + Solve(arr, k + 1, j) 
                               + arr[i - 1] * arr[k] * arr[j];

                   // Update minimum cost found so far
                   if (tempAns < minCost) {
                       minCost = tempAns;
                   }
               }

               // Memoize and return the final minimum cost for this subproblem
               return t[i][j] = minCost;
           }
}
