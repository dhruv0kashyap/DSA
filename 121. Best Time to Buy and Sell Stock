class Solution {
    public int maxProfit(int[] prices) {

        int n = prices.length;
        int k = 2;

        int[][] t = new int[n+1][k+1];

        for(int i = 0; i < n+1; i++)
        Arrays.fill(t[i], -1);

        solve(prices, n, 0, k, t);

        return t[0][k];
    }

    public int solve(int[] prices, int n, int i, int k, int[][] t){

        if(i == n)
        return t[i][k] = 0;

        if(k == 0)
        return t[i][k] = 0;

        if(t[i][k] != -1)
        return t[i][k];

        if(k == 2){
            int c1 = solve(prices, n, i+1, k-1, t) - prices[i];

            int c2 = solve(prices, n, i+1, k, t);

            return t[i][k] = Math.max(c1, c2);
        }
        else{
            int d1 = solve(prices, n, i+1, k-1, t) + prices[i];

            int d2 = solve(prices, n, i+1, k, t);

            return t[i][k] = Math.max(d1, d2);
        }
    }
}

Tabulation--------------------------------------------------------------------------------------------------------------------------------

class Solution {
    public int maxProfit(int[] prices) {

        int n = prices.length;
        int k = 2;

        int[][] t = new int[n + 1][k + 1];

        // Base cases
        // i == n => 0
        // k == 0 => 0
        // Java already initializes everything to 0

        for(int i = n - 1; i >= 0; i--) {

            for(int j = 1; j <= k; j++) {

                if(j == 2) {

                    int c1 = t[i + 1][j - 1] - prices[i];

                    int c2 = t[i + 1][j];

                    t[i][j] = Math.max(c1, c2);

                }
                else {

                    int d1 = t[i + 1][j - 1] + prices[i];

                    int d2 = t[i + 1][j];

                    t[i][j] = Math.max(d1, d2);
                }
            }
        }

        return t[0][k];
    }
}


